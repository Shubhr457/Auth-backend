{
  "name": "auth-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js Authentication REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit"
  },
